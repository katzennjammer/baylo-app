{
  "expo": {
    "name": "Baylo",
    "slug": "baylo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": ["baylo", "com.baylo.app"],
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAF7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baylo.app"
    },
    "android": {
      "package": "com.baylo.app",
      "adaptiveIcon": {
        "backgroundColor": "#032206",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Baylo uses the camera so you can photograph the item you are listing. Photos taken here carry a camera mark on your listing.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Baylo needs your photo library so you can choose pictures of the item you are listing."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
            "./assets/fonts/BricolageGrotesque-Bold.ttf",
            "./assets/fonts/PublicSans-Regular.ttf",
            "./assets/fonts/PublicSans-Medium.ttf",
            "./assets/fonts/PublicSans-SemiBold.ttf",
            "./assets/fonts/PublicSans-Bold.ttf",
            "./assets/fonts/JetBrainsMono-Regular.ttf",
            "./assets/fonts/JetBrainsMono-Medium.ttf",
            "./assets/fonts/Archivo-Regular.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf",
            "./assets/fonts/Archivo-ExtraBold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a4d4029-1bf6-4898-9023-e5724f5f594b"
      }
    }
  }
}
