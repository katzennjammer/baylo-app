{
  "name": "baylo-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.102.4",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.33",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-location": "~57.0.23",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "nativewind": "^4.2.6",
    "phosphor-react-native": "^3.0.6",
    "pusher-js": "^8.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "1.5.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify:api": "tsx scripts/verify-api-client.cjs",
    "verify:map": "tsx scripts/verify-map-document.cjs",
    "verify:location": "tsx scripts/verify-location-timeout.cjs",
    "verify:wordmark": "node scripts/verify-wordmark.cjs",
    "verify:ai-valuation": "node --require ./scripts/rn-stub.cjs --require ./scripts/securestore-fake.cjs --import tsx scripts/verify-ai-valuation-state.ts",
    "verify:opening": "node --require ./scripts/rn-stub.cjs --require ./scripts/securestore-fake.cjs --import tsx scripts/verify-opening-tier.ts",
    "verify:tutorial": "tsx scripts/verify-tutorial.ts",
    "verify:search-helper": "tsx scripts/verify-search-helper.ts",
    "verify:trade-sides": "node --require ./scripts/rn-stub.cjs --import tsx scripts/verify-trade-sides.ts",
    "verify:meetup": "node --require ./scripts/rn-stub.cjs --import tsx scripts/verify-meetup-chat.ts",
    "verify:images": "node --import tsx scripts/verify-image-delivery.ts",
    "verify:password": "node --import tsx scripts/verify-password-strength.ts",
    "verify:removal": "node --import tsx scripts/verify-listing-removal.ts",
    "verify:push": "node --require ./scripts/rn-stub.cjs --require ./scripts/securestore-fake.cjs --import tsx scripts/verify-push-target.ts",
    "verify:chat-image": "node --import tsx scripts/verify-chat-image-sizing.ts",
    "vendor:leaflet": "node scripts/vendor-leaflet.mjs",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "build:status": "eas build:list --platform android --limit 5",
    "phone": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode wireless",
    "phone:wireless": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode wireless",
    "phone:pair": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode wireless -Pair",
    "phone:unpair": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Unpair",
    "phone:pin": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode wireless -PinPort",
    "phone:hotspot": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode hotspot",
    "phone:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode tunnel",
    "phone:lan": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -Mode lan",
    "phone:reset": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -ClearBundleHost",
    "phone:show": "powershell -ExecutionPolicy Bypass -File scripts/connect-phone.ps1 -ShowOnly"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.2.3"
  }
}
